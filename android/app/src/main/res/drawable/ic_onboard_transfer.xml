<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:viewportWidth="140"
    android:viewportHeight="140"
    android:width="140dp"
    android:height="140dp">

    <!-- Outer glow -->
    <path android:pathData="M70,70 m-60,0 a60,60 0 1,0 120,0 a60,60 0 1,0 -120,0"
        android:fillColor="#1a56db"
        android:fillAlpha="0.12"/>

    <!-- Inner circle -->
    <path android:pathData="M70,70 m-44,0 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="26" android:startY="26"
                android:endX="114" android:endY="114"
                android:type="linear">
                <item android:offset="0" android:color="#FF1e40af"/>
                <item android:offset="1" android:color="#FF1a56db"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrow up (send) -->
    <path android:pathData="M58,76 L58,56 M50,64 L58,56 L66,64"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Arrow down (receive) -->
    <path android:pathData="M82,64 L82,84 M74,76 L82,84 L90,76"
        android:strokeColor="#FFf97316"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Lightning bolt small -->
    <path android:pathData="M69,58 L66,68 L70,68 L67,82"
        android:strokeColor="#FFfb923c"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
