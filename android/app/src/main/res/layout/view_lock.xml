<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mozosubz_bg_dark">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- App logo -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/mozosubz_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mozosubz"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="40dp" />

        <!-- Fingerprint hint icon (system vector) -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:alpha="0.6"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <!-- Instruction text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch sensor or use Face ID to unlock"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Manual retry button (in case prompt dismissed without acting) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Unlock"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/mozosubz_primary"
            app:cornerRadius="24dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

</FrameLayout>
