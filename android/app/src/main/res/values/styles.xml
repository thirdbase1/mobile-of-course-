<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mozosubz_primary</item>
        <item name="colorPrimaryDark">@color/mozosubz_primary_dark</item>
        <item name="colorAccent">@color/mozosubz_accent</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <!-- Main activity theme — edge-to-edge, dark brand bars -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Dark background prevents white flash before the page loads -->
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Dark brand status bar — white icons clearly visible -->
        <item name="android:statusBarColor">@color/splash_background</item>
        <!-- Dark brand nav bar — white handles clearly visible -->
        <item name="android:navigationBarColor">@color/splash_background</item>
        <!-- false = light (white) icons on dark bar -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Launch / splash theme — dark background with centered logo -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- Onboarding screens -->
    <style name="OnboardingTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mozosubz_primary</item>
        <item name="colorPrimaryDark">@color/mozosubz_primary_dark</item>
        <item name="colorAccent">@color/mozosubz_accent</item>
        <item name="android:windowBackground">@color/mozosubz_bg_dark</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

</resources>
