# ── Required ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
FRONTEND_URL=https://your-frontend.pxxl.app

# GitHub OAuth App (create at github.com/settings/developers)
# Callback URL: https://your-backend.pxxl.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Providers (also configurable per-user in Settings) ────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# Code execution sandbox
JUDGE0_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, for local dev)
DATABASE_URL=sqlite+aiosqlite:///./agentforge.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@host:5432/agentforge

# ── Optional ─────────────────────────────────────────────────────────────────
# BACKEND_URL= (set in frontend if backend is on a different domain)
