# ── Required: GitHub OAuth ───────────────────────────────────────────────────
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: https://your-backend.pxxl.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (where users access the app)
FRONTEND_URL=https://your-frontend.pxxl.app

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-64-chars

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero config — file stored in backend directory)
DATABASE_URL=sqlite+aiosqlite:///./gitcode.db

# PostgreSQL (optional — Neon, Supabase, or any Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/gitcode

# ── AI Keys (optional — users can also set these per-account in Settings) ────
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# ── Code execution (optional — users can set this in Settings) ───────────────
# Get free key at: rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=
